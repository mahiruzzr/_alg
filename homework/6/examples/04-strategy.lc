# 04-strategy.lc：normal vs applicative 差異（經典例子）
# 執行：
#   python lambda_interp.py --prelude examples/prelude.lc --strategy normal examples/04-strategy.lc
#   python lambda_interp.py --prelude examples/prelude.lc --strategy applicative examples/04-strategy.lc --max-steps 15
# 需要 prelude（TRUE/FALSE...）+ 本檔自帶 OMEGA
# (λx.y) Ω ：normal 策略直接丟掉 Ω 得 y；applicative 會先算 Ω 而發散

let OMEGA = (\x.x x) (\x.x x)
let CONST_Y = \x.y

CONST_Y OMEGA
