# 03-numeral.lc：Church Numerals 算術
# 執行：python lambda_interp.py --prelude examples/prelude.lc examples/03-numeral.lc
# NUMBER 語法糖：2 會自動展開成 λf.λx.f (f x)

# SUCC 2 → 3（解譯器最後會「解讀為：3 (Church numeral)」）
SUCC 2

# ADD 2 3 → 5
ADD 2 3

# MULT 2 3 → 6
MULT 2 3

# POW 2 3 → 8
POW 2 3

# PRED 3 → 2
PRED 3

# SUB 5 2 → 3
SUB 5 2

# ISZERO 0 → TRUE；ISZERO 3 → FALSE
ISZERO 0
ISZERO 3
