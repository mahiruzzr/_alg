# Prelude：Church encoding 基本定義（布林 / 數字 / 邏輯 / 算術 / List / Y）
# 載入方式：python lambda_interp.py --prelude examples/prelude.lc examples/05-factorial.lc
# 或在檔案開頭用複製貼上引入。

# --- Booleans ---
let TRUE = \x.\y.x
let FALSE = \x.\y.y
let IF = \c.\x.\y.c x y
let AND = \p.\q.p q p
let OR = \p.\q.p p q
let NOT = \c.c FALSE TRUE
let XOR = \p.\q.p (NOT q) q

# --- Numerals & Arithmetic ---
let SUCC = \n.\f.\x.f (n f x)
let ADD = \m.\n.n SUCC m
let MULT = \m.\n.\f.m (n f)
let POW = \x.\y.y x
let PRED = \n.\f.\x.n (\g.\h.h (g f)) (\u.x) (\u.u)
let SUB = \m.\n.n PRED m
let ISZERO = \n.n (\x.FALSE) TRUE
let LEQ = \m.\n.ISZERO (SUB m n)
let EQ = \m.\n.AND (LEQ m n) (LEQ n m)

# --- Lists ---
let NIL = \x.TRUE
let CONS = \x.\y.\f.f x y
let CAR = \p.p TRUE
let CDR = \p.p FALSE
let ISNIL = \p.p (\a.\b.FALSE)

# --- Y combinator (applicative-order 安全版 Z 也一併提供) ---
let Y = \f.(\x.f (x x)) (\x.f (x x))
let Z = \f.(\x.f (\y.x x y)) (\x.f (\y.x x y))
